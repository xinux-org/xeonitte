#: src/utils/flow.rs:66
msgid "Enable Flatpak support"
msgstr "Flatpak paket menejerini yoqish"

#: src/utils/flow.rs:72
msgid "AppImage"
msgstr "AppImage paket menejerini yoqish"

#: src/utils/flow.rs:74
msgid ""
"Enable AppImage support by installing the \"appimage-run\" package. For "
"AppImages to work, you must run them with the \"appimage-run\" command."
msgstr ""
"\"appimage-run\" paketini oʻrnatish orqali AppImage qoʻllab-quvvatlashini "
"yoqing. AppImage fayllari ishlashi uchun \"appimage-run\" buyrugʻi yordamida "
"ishga tushirishingiz kerak."

#: src/utils/flow.rs:81
msgid "Minimal"
msgstr "Minimal"

#: src/utils/flow.rs:82
msgid "Install minimal Xinux without GNOME core apps"
msgstr "GNOME asosiy ilovalarisiz, minimal Xinux tizimini oʻrnatish"

